PORT=8080
# URL service di belakang gateway (lokal). Saat deploy, ganti dengan URL publik tiap service tanpa garis miring di akhir.
SERVICE_A_URL=http://localhost:3000
SERVICE_B_URL=http://localhost:3001
# API key untuk route /booking. GANTI dengan nilai acak milik kelompok Anda; jangan commit file .env
API_KEY=ganti-dengan-key-rahasia-kelompok
