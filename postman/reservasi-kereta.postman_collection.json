        {
          "name": "Booking dengan Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"perjalananId\": \"KA-003\",\n  \"kursi\": [\"{{kursiIdem}}\"],\n  \"penumpang\": { \"nama\": \"Citra\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Klik Send DUA KALI: respons kedua sama persis (id sama) dan ada header Idempotent-Replayed: true, tidak ada booking ganda."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('idemKey')) {",
                  "  pm.collectionVariables.set('idemKey', 'idem-' + Date.now());",
                  "  pm.collectionVariables.set('kursiIdem', (1 + Math.floor(Math.random() * 10)) + 'ABCD'[Math.floor(Math.random() * 4)]);",
                  "}"
                ]
              }
            },
