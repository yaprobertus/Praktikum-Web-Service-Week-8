            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"perjalananId\": \"KA-002\",\n  \"kursi\": [\"{{kursi}}\"],\n  \"penumpang\": { \"nama\": \"Budi Santoso\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Mengunci kursi. ID booking otomatis disimpan ke variabel {{bookingId}}."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// kursi acak baru tiap kali, supaya bisa dijalankan berulang kali",
                  "const baris = 1 + Math.floor(Math.random() * 10);",
                  "const huruf = 'ABCD'[Math.floor(Math.random() * 4)];",
                  "pm.collectionVariables.set('kursi', baris + huruf);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('bookingId', b.id);",
                  "pm.test('Status MENUNGGU_PEMBAYARAN', function () { pm.expect(b.status).to.eql('MENUNGGU_PEMBAYARAN'); });"
                ]
              }
            }
          ]
        },
